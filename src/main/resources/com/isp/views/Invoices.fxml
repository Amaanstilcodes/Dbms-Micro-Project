<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Invoices.fxml
    Controller: com.isp.controller.InvoicesController
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isp.controller.InvoicesController"
      prefWidth="1100" prefHeight="680"
      styleClass="root-pane">

    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="📡 ISP System" styleClass="sidebar-logo"/>
        <Label text="Management Portal" styleClass="sidebar-subtitle"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Label text="BILLING" styleClass="sidebar-section-label"/>
        <Button text="🏠  Dashboard" styleClass="nav-button" maxWidth="220" onAction="#goBack"/>
        <Button text="🧾  Invoices"  styleClass="nav-button nav-button-active" maxWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Button text="← Back to Dashboard" styleClass="nav-logout" maxWidth="220" onAction="#goBack"/>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="16">

        <VBox spacing="2">
            <Label text="Invoices" styleClass="page-title"/>
            <Label text="View billing invoices, outstanding amounts and record payments." styleClass="page-subtitle"/>
        </VBox>

        <HBox styleClass="toolbar-bar" spacing="8" alignment="CENTER_LEFT">
            <Label text="Status:"/>
            <ComboBox fx:id="statusFilter" onAction="#handleFilterChange" prefWidth="160"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="recordPaymentButton" text="💳 Record Payment" styleClass="btn-primary" onAction="#handleRecordPayment"/>
        </HBox>

        <TableView fx:id="invoiceTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"          text="ID"           prefWidth="55"/>
                <TableColumn fx:id="colCustomer"    text="Customer"     prefWidth="160"/>
                <TableColumn fx:id="colPlan"        text="Plan"         prefWidth="140"/>
                <TableColumn fx:id="colDue"         text="Due Date"     prefWidth="100"/>
                <TableColumn fx:id="colTotal"       text="Total (₹)"    prefWidth="100"/>
                <TableColumn fx:id="colPaid"        text="Paid (₹)"     prefWidth="100"/>
                <TableColumn fx:id="colOutstanding" text="Outstanding (₹)" prefWidth="110"/>
                <TableColumn fx:id="colStatus"      text="Status"       prefWidth="110"/>
            </columns>
            <placeholder>
                <Label text="No invoices found."/>
            </placeholder>
        </TableView>

        <HBox styleClass="status-bar">
            <Label fx:id="summaryLabel" text="Ready"/>
        </HBox>

    </VBox>
</HBox>
