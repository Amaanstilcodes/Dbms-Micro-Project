<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Reports.fxml
    Controller: com.isp.controller.ReportsController
    Shows 6 report buttons (one per DB view) + a results area.
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isp.controller.ReportsController"
      prefWidth="1100" prefHeight="680"
      styleClass="root-pane">

    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="📡 ISP System" styleClass="sidebar-logo"/>
        <Label text="Management Portal" styleClass="sidebar-subtitle"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Label text="ANALYTICS" styleClass="sidebar-section-label"/>
        <Button text="🏠  Dashboard" styleClass="nav-button" maxWidth="220" onAction="#goBack"/>
        <Button text="📊  Reports"   styleClass="nav-button nav-button-active" maxWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Button text="← Back to Dashboard" styleClass="nav-logout" maxWidth="220" onAction="#goBack"/>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="20">

        <VBox spacing="2">
            <Label text="Reports &amp; Analytics" styleClass="page-title"/>
            <Label text="Run pre-built SQL views for business insights." styleClass="page-subtitle"/>
        </VBox>

        <!-- Report button grid -->
        <GridPane hgap="12" vgap="12">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="ALWAYS"/>
                <ColumnConstraints hgrow="ALWAYS"/>
            </columnConstraints>

            <!-- Row 0 -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="0"
                  styleClass="kpi-card" spacing="8">
                <Label text="📋 Active Subscriptions" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_active_subscriptions — joined customer, plan, area."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runActiveSubscriptionsReport"/>
            </VBox>

            <VBox GridPane.columnIndex="1" GridPane.rowIndex="0"
                  styleClass="kpi-card" spacing="8">
                <Label text="⚠️ Overdue Invoices" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_overdue_invoices — past due, not fully paid, days overdue."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runOverdueInvoicesReport"/>
            </VBox>

            <VBox GridPane.columnIndex="2" GridPane.rowIndex="0"
                  styleClass="kpi-card" spacing="8">
                <Label text="💰 Monthly Revenue" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_monthly_revenue — revenue by month and plan type."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runMonthlyRevenueReport"/>
            </VBox>

            <!-- Row 1 -->
            <VBox GridPane.columnIndex="0" GridPane.rowIndex="1"
                  styleClass="kpi-card" spacing="8">
                <Label text="👤 Customer Balance" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_customer_balance — total billed, paid, outstanding per customer."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runCustomerBalanceReport"/>
            </VBox>

            <VBox GridPane.columnIndex="1" GridPane.rowIndex="1"
                  styleClass="kpi-card" spacing="8">
                <Label text="🔧 Technician Workload" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_technician_workload — open tickets and installations per tech."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runTechnicianWorkloadReport"/>
            </VBox>

            <VBox GridPane.columnIndex="2" GridPane.rowIndex="1"
                  styleClass="kpi-card" spacing="8">
                <Label text="📶 Data Usage Summary" style="-fx-font-weight:bold; -fx-font-size:13px; -fx-text-fill:#1e293b;"/>
                <Label text="v_data_usage_summary — monthly GB used vs data cap per subscription."
                       wrapText="true" style="-fx-text-fill:#64748b; -fx-font-size:12px;"/>
                <Button text="▶ Run Report" styleClass="btn-primary"
                        onAction="#runDataUsageSummaryReport"/>
            </VBox>

        </GridPane>

        <!-- Status / result area -->
        <VBox styleClass="kpi-card" VBox.vgrow="ALWAYS" spacing="8">
            <Label text="Results" style="-fx-font-weight:bold; -fx-font-size:14px; -fx-text-fill:#1e293b;"/>
            <Label fx:id="reportStatusLabel"
                   text="Select a report above to generate output."
                   style="-fx-text-fill:#64748b;"/>
            <!-- TODO: add TableView here to display report rows -->
        </VBox>

    </VBox>
</HBox>
