<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    SupportTickets.fxml
    Controller: com.isp.controller.SupportTicketsController
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isp.controller.SupportTicketsController"
      prefWidth="1100" prefHeight="680"
      styleClass="root-pane">

    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="📡 ISP System" styleClass="sidebar-logo"/>
        <Label text="Management Portal" styleClass="sidebar-subtitle"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Label text="SUPPORT" styleClass="sidebar-section-label"/>
        <Button text="🏠  Dashboard"       styleClass="nav-button" maxWidth="220" onAction="#goBack"/>
        <Button text="🎫  Support Tickets" styleClass="nav-button nav-button-active" maxWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Button text="← Back to Dashboard" styleClass="nav-logout" maxWidth="220" onAction="#goBack"/>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="16">

        <VBox spacing="2">
            <Label text="Support Tickets" styleClass="page-title"/>
            <Label text="Track and resolve customer-raised issues by category and priority." styleClass="page-subtitle"/>
        </VBox>

        <HBox styleClass="toolbar-bar" spacing="8" alignment="CENTER_LEFT">
            <Label text="Status:"/>
            <ComboBox fx:id="statusFilter"   onAction="#handleFilterChange" prefWidth="140"/>
            <Label text="Priority:"/>
            <ComboBox fx:id="priorityFilter" onAction="#handleFilterChange" prefWidth="110"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addButton"     text="➕ New Ticket"    styleClass="btn-primary"  onAction="#handleAdd"/>
            <Button fx:id="editButton"    text="✏️ Edit"          styleClass="btn-secondary" onAction="#handleEdit"/>
            <Button fx:id="resolveButton" text="✅ Resolve"       styleClass="btn-success"   onAction="#handleResolve"/>
        </HBox>

        <TableView fx:id="ticketTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"         text="#"           prefWidth="50"/>
                <TableColumn fx:id="colCustomer"   text="Customer"    prefWidth="160"/>
                <TableColumn fx:id="colCategory"   text="Category"    prefWidth="110"/>
                <TableColumn fx:id="colPriority"   text="Priority"    prefWidth="90"/>
                <TableColumn fx:id="colSubject"    text="Subject"     prefWidth="240"/>
                <TableColumn fx:id="colTechnician" text="Assigned To" prefWidth="140"/>
                <TableColumn fx:id="colStatus"     text="Status"      prefWidth="120"/>
                <TableColumn fx:id="colCreated"    text="Opened"      prefWidth="140"/>
            </columns>
            <placeholder>
                <Label text="No tickets found."/>
            </placeholder>
        </TableView>

        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>

    </VBox>
</HBox>
