<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Customers.fxml
    Controller: com.isp.controller.CustomersController
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isp.controller.CustomersController"
      prefWidth="1100" prefHeight="680"
      styleClass="root-pane">

    <!-- Sidebar (reusable pattern) -->
    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="📡 ISP System" styleClass="sidebar-logo"/>
        <Label text="Management Portal" styleClass="sidebar-subtitle"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Label text="MAIN MENU" styleClass="sidebar-section-label"/>
        <Button text="🏠  Dashboard"         styleClass="nav-button" maxWidth="220" onAction="#goBack"/>
        <Button text="👥  Customers"          styleClass="nav-button nav-button-active" maxWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Button text="← Back to Dashboard" styleClass="nav-logout" maxWidth="220" onAction="#goBack"/>
    </VBox>

    <!-- Content -->
    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="16">

        <!-- Header -->
        <VBox spacing="2">
            <Label text="Customers" styleClass="page-title"/>
            <Label text="Manage individual and business ISP subscribers." styleClass="page-subtitle"/>
        </VBox>

        <!-- Toolbar -->
        <HBox styleClass="toolbar-bar" spacing="8" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="🔍  Search by name or email…"
                       styleClass="search-field" onAction="#handleSearch"/>
            <Button text="Search" styleClass="btn-secondary" onAction="#handleSearch"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addButton"    text="➕ Add Customer"  styleClass="btn-primary"   onAction="#handleAdd"/>
            <Button fx:id="editButton"   text="✏️ Edit"          styleClass="btn-secondary"  onAction="#handleEdit"/>
            <Button fx:id="deleteButton" text="🗑 Delete"        styleClass="btn-danger"     onAction="#handleDelete"/>
        </HBox>

        <!-- Table -->
        <TableView fx:id="customerTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"     text="ID"       prefWidth="50"/>
                <TableColumn fx:id="colName"   text="Full Name" prefWidth="180"/>
                <TableColumn fx:id="colType"   text="Type"      prefWidth="100"/>
                <TableColumn fx:id="colEmail"  text="Email"     prefWidth="210"/>
                <TableColumn fx:id="colPhone"  text="Phone"     prefWidth="120"/>
                <TableColumn fx:id="colArea"   text="Area"      prefWidth="130"/>
                <TableColumn fx:id="colStatus" text="Status"    prefWidth="90"/>
            </columns>
            <placeholder>
                <Label text="No customers found. Click '➕ Add Customer' to get started."/>
            </placeholder>
        </TableView>

        <!-- Status Bar -->
        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>

    </VBox>
</HBox>
