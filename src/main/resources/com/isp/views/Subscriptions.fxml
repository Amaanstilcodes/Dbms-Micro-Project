<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    Subscriptions.fxml
    Controller: com.isp.controller.SubscriptionsController
-->
<HBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.isp.controller.SubscriptionsController"
      prefWidth="1100" prefHeight="680"
      styleClass="root-pane">

    <VBox styleClass="sidebar" prefWidth="220" minWidth="220">
        <Label text="📡 ISP System" styleClass="sidebar-logo"/>
        <Label text="Management Portal" styleClass="sidebar-subtitle"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Label text="MAIN MENU" styleClass="sidebar-section-label"/>
        <Button text="🏠  Dashboard"      styleClass="nav-button" maxWidth="220" onAction="#goBack"/>
        <Button text="🔗  Subscriptions" styleClass="nav-button nav-button-active" maxWidth="220"/>
        <Region VBox.vgrow="ALWAYS"/>
        <Separator style="-fx-background-color:#2d3f6b;"/>
        <Button text="← Back to Dashboard" styleClass="nav-logout" maxWidth="220" onAction="#goBack"/>
    </VBox>

    <VBox HBox.hgrow="ALWAYS" styleClass="content-area" spacing="16">

        <VBox spacing="2">
            <Label text="Subscriptions" styleClass="page-title"/>
            <Label text="Customer-plan contracts. Status: PENDING → ACTIVE → SUSPENDED | TERMINATED." styleClass="page-subtitle"/>
        </VBox>

        <HBox styleClass="toolbar-bar" spacing="8" alignment="CENTER_LEFT">
            <Label text="Filter:"/>
            <ComboBox fx:id="statusFilter" onAction="#handleFilterChange" prefWidth="140"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="addButton"          text="➕ New Subscription"  styleClass="btn-primary"  onAction="#handleAdd"/>
            <Button fx:id="editButton"         text="✏️ Edit"              styleClass="btn-secondary" onAction="#handleEdit"/>
            <Button fx:id="changeStatusButton" text="🔄 Change Status"     styleClass="btn-success"   onAction="#handleChangeStatus"/>
        </HBox>

        <TableView fx:id="subTable" VBox.vgrow="ALWAYS" styleClass="table-view">
            <columns>
                <TableColumn fx:id="colId"       text="ID"         prefWidth="55"/>
                <TableColumn fx:id="colCustomer" text="Customer"   prefWidth="180"/>
                <TableColumn fx:id="colPlan"     text="Plan"       prefWidth="180"/>
                <TableColumn fx:id="colArea"     text="Area"       prefWidth="120"/>
                <TableColumn fx:id="colStart"    text="Start Date" prefWidth="100"/>
                <TableColumn fx:id="colEnd"      text="End Date"   prefWidth="100"/>
                <TableColumn fx:id="colStatus"   text="Status"     prefWidth="100"/>
            </columns>
            <placeholder>
                <Label text="No subscriptions found."/>
            </placeholder>
        </TableView>

        <HBox styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready"/>
        </HBox>

    </VBox>
</HBox>
